---
// Pantalla puente del cambio de marca: Lumina Consulting pasa a INFLEXIA.
//
// Es una pagina terminal, sin header ni footer del sitio: quien llega aca ya no
// tiene nada que navegar en el sitio viejo. Todas las rutas de marketing caen
// aca por los redirects 307 de vercel.json, que dejan fuera a proposito las
// rutas operativas (/vivo, /links, /clase-ia, /api), que siguen vivas.
//
// Autocontenida por diseno: el CSS y el SVG van embebidos para que la pantalla
// no dependa de los assets del sitio viejo ni del build de Tailwind.
//
// El salto lo hace el JS con un contador visible y se puede detener, que es lo
// que pide WCAG 2.2.1. No hay meta refresh: sin JS la persona ve el aviso y el
// enlace, que es el comportamiento correcto y el que ven los buscadores.
//
// Temporal por diseno. Cuando el aviso deje de hacer falta, esto se reemplaza
// por un 301 permanente a inflexia.cl (ver PLAN de la migracion de marca).

interface Textos {
  title: string;
  description: string;
  kicker: string;
  tituloAntes: string;
  parrafo: string;
  nota: string;
  contadorAntes: string;
  contadorDespues: string;
  detenido: string;
  irAhora: string;
  quedarme: string;
}

interface Props {
  lang: string;
  t: Textos;
}

const { lang, t } = Astro.props;
const DESTINO = 'https://inflexia.cl/';
const SEGUNDOS = 6;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={DESTINO} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={DESTINO} />

    <!-- Analítica propia (Umami en el VPS). Va acá porque esta pantalla es hoy
         la única página visible del dominio, así que sin esto no se registraría
         ninguna visita. Las de Jorge se excluyen una vez en /no-contar. -->
    <script
      is:inline
      defer
      src="https://analitica.inflexia.cl/script.js"
      data-website-id="880dcb79-3dad-48c2-8a76-582f733d3aaf"></script>

    <style is:inline>
      :root {
        --tinta-900: #0a2133;
        --tinta-700: #0f2e44;
        --tinta-300: #6e8ca3;
        --teal-700: #14606c;
        --teal-500: #1b7e8c;
        --fondo: #f5f7f8;
        --blanco: #ffffff;
        --borde: #dde3e7;
        --gris: #5e6b75;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem 1.25rem;
        background: var(--fondo);
        color: var(--tinta-700);
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        font-size: 1rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      main {
        width: 100%;
        max-width: 34rem;
        text-align: center;
      }

      .kicker {
        margin: 0 0 1.75rem;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--teal-700);
      }

      h1 {
        margin: 0;
        font-size: clamp(1.25rem, 4vw, 1.6rem);
        font-weight: 400;
        line-height: 1.35;
        color: var(--tinta-700);
      }

      .wordmark {
        display: block;
        width: 100%;
        max-width: 17rem;
        height: auto;
        margin: 1.5rem auto 0;
      }

      .solo-lectores {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
      }

      .parrafo {
        margin: 2.25rem 0 0;
        color: var(--gris);
      }

      .parrafo a {
        color: var(--teal-700);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.15em;
      }

      .nota {
        margin: 1rem 0 0;
        font-size: 0.875rem;
        color: var(--tinta-300);
      }

      .botonera {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 2.25rem;
      }

      .boton {
        display: inline-block;
        padding: 0.7rem 1.4rem;
        border-radius: 3px;
        border: 1px solid transparent;
        font: inherit;
        font-size: 0.9375rem;
        cursor: pointer;
        text-decoration: none;
      }

      .boton-primario {
        background: var(--tinta-700);
        color: var(--blanco);
      }

      .boton-primario:hover {
        background: var(--tinta-900);
      }

      .boton-secundario {
        background: var(--blanco);
        border-color: var(--borde);
        color: var(--tinta-700);
      }

      .boton-secundario:hover {
        border-color: var(--tinta-300);
      }

      .boton:focus-visible {
        outline: 2px solid var(--teal-500);
        outline-offset: 2px;
      }

      .tiempo {
        margin: 1.5rem 0 0;
        font-size: 0.875rem;
        color: var(--gris);
        min-height: 1.4em;
      }

      .cuenta {
        font-variant-numeric: tabular-nums;
        font-weight: 600;
        color: var(--tinta-700);
      }
    </style>
  </head>

  <body>
    <main>
      <p class="kicker">{t.kicker}</p>

      <h1>
        {t.tituloAntes}
        <svg
          class="wordmark"
          viewBox="0 0 628.84 248.88"
          role="img"
          aria-hidden="true"
          focusable="false"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M39.8 87.3Q39.8 90.2 42 92.5Q44.2 94.7 47.2 94.7Q50.4 94.7 52.5 92.5Q54.6 90.2 54.6 87.3Q54.6 84.1 52.5 82Q50.4 79.9 47.2 79.9Q44.2 79.9 42 82Q39.8 84.1 39.8 87.3ZM42 128.9V220.9H52.4V128.9Z"
            fill="#0F2E44"></path>
          <path
            d="M143.6 161.7V220.9H154V160.5Q154 145.2 146.4 136Q138.8 126.9 124.4 126.9Q114.2 126.9 106.5 132.4Q98.9 138 95 148.1V128.9H84.6V220.9H95V164.9Q95 157 98.5 150.6Q101.9 144.2 108.1 140.4Q114.2 136.7 122 136.7Q133.2 136.7 138.4 143.3Q143.6 150 143.6 161.7Z"
            fill="#0F2E44"></path>
          <path
            d="M177 128.9V138.7H220.2V128.9ZM222.1 80.2 228 71.7Q226.6 69.7 224.1 67.7Q221.6 65.8 218.3 64.4Q215 63 210.6 63Q202.2 63 196.8 66.7Q191.4 70.4 188.7 77.2Q186 83.9 186 93.3V220.9H196.4V94.5Q196.4 88.3 197.8 83.5Q199.1 78.8 202.1 76.1Q205 73.4 210 73.4Q213.7 73.4 216.8 75.2Q220 76.9 222.1 80.2Z"
            fill="#0F2E44"></path>
          <path d="M239 64.9V220.9H249.4V64.9Z" fill="#0F2E44"></path>
          <path
            d="M314 222.9Q327.9 222.9 338.1 217.1Q348.4 211.4 356.2 199.5L347.7 194.1Q341.5 203.9 333.6 208.5Q325.8 213.1 315.2 213.1Q305.1 213.1 297.6 208.2Q290.2 203.4 286 194.6Q281.9 185.8 281.9 174.1Q282 162.6 286.3 154.1Q290.5 145.6 298 140.8Q305.5 136.1 315.6 136.1Q324.5 136.1 331.4 140.3Q338.4 144.6 342.5 151.9Q346.5 159.2 346.5 168.7Q346.5 170.2 346.1 172Q345.6 173.7 345.1 174.7L349.5 168.5H278.1V177.4H357.5Q357.6 176.6 357.7 175.1Q357.8 173.6 357.8 172.5Q357.8 159 352.4 148.7Q347.1 138.4 337.7 132.7Q328.2 126.9 315.6 126.9Q302.6 126.9 292.6 133Q282.6 139 277 149.8Q271.4 160.6 271.4 174.7Q271.4 188.8 276.9 199.6Q282.3 210.4 292 216.7Q301.6 222.9 314 222.9Z"
            fill="#0F2E44"></path>
          <path
            d="M483.2 87.3Q483.2 90.2 485.4 92.5Q487.6 94.7 490.6 94.7Q493.8 94.7 495.9 92.5Q498 90.2 498 87.3Q498 84.1 495.9 82Q493.8 79.9 490.6 79.9Q487.6 79.9 485.4 82Q483.2 84.1 483.2 87.3ZM485.4 128.9V220.9H495.8V128.9Z"
            fill="#0F2E44"></path>
          <path
            d="M529.6 193.2Q529.6 186.4 532.8 181.9Q536 177.5 541.7 175.3Q547.4 173.1 555.2 173.1Q563.7 173.1 571.4 175.3Q579 177.6 585.8 182.6V175.9Q584.1 174.1 579.9 171.5Q575.7 168.8 569.2 166.8Q562.7 164.7 553.6 164.7Q537.6 164.7 528.3 172.5Q519 180.3 519 193.8Q519 203.4 523.5 209.9Q527.9 216.4 535.1 219.6Q542.2 222.9 550 222.9Q558.1 222.9 565.9 219.5Q573.6 216.1 578.8 209Q584 202 584 191.3L581.6 182.5Q581.6 192.6 577.6 199.7Q573.6 206.7 567.1 210.2Q560.6 213.8 552.8 213.8Q546.5 213.8 541.2 211.6Q535.9 209.4 532.7 204.8Q529.6 200.2 529.6 193.2ZM530 145.7Q532.6 143.8 536.6 141.5Q540.5 139.3 545.9 137.7Q551.3 136.1 558.1 136.1Q564.7 136.1 569.3 137.8Q573.8 139.6 576.5 142.6Q579.2 145.6 580.4 149.3Q581.6 153 581.6 157V220.9H592V155.7Q592 146.4 588 140Q584.1 133.6 576.7 130.3Q569.2 126.9 558.8 126.9Q546.7 126.9 538.3 130.6Q530 134.2 524.9 138Z"
            fill="#0F2E44"></path>
          <path
            d="M 373.45 126.12 L 459.59 223.64"
            fill="none"
            stroke="#0F2E44"
            stroke-width="7.70"
            stroke-linecap="butt"></path>
          <path
            d="M 373.45 223.64 C 425.13 204.14 407.91 145.62 459.59 126.12"
            fill="none"
            stroke="#1B7E8C"
            stroke-width="9.57"
            stroke-linecap="round"></path>
        </svg>
        <span class="solo-lectores">INFLEXIA</span>
      </h1>

      <p class="parrafo" set:html={t.parrafo} />
      <p class="nota">{t.nota}</p>

      <div class="botonera">
        <a class="boton boton-primario" href={DESTINO}>{t.irAhora}</a>
        <button class="boton boton-secundario" type="button" id="detener">{t.quedarme}</button>
      </div>

      <p class="tiempo" id="tiempo" data-detenido={t.detenido}>
        {t.contadorAntes}<span class="cuenta" id="cuenta">{SEGUNDOS}</span>{t.contadorDespues}
      </p>
    </main>

    <script is:inline>
      (function () {
        var DESTINO = 'https://inflexia.cl/';
        var restantes = 6;

        var tiempo = document.getElementById('tiempo');
        var cuenta = document.getElementById('cuenta');
        var boton = document.getElementById('detener');
        if (!tiempo || !cuenta || !boton) return;

        var timer = window.setInterval(function () {
          restantes -= 1;
          if (restantes <= 0) {
            window.clearInterval(timer);
            window.location.replace(DESTINO);
            return;
          }
          cuenta.textContent = String(restantes);
        }, 1000);

        boton.addEventListener('click', function () {
          window.clearInterval(timer);
          tiempo.textContent = tiempo.getAttribute('data-detenido') || '';
          boton.hidden = true;
        });
      })();
    </script>
  </body>
</html>
